# ==============================================================================
# Whatsap-Automat — Variables de Entorno de Referencia (Monorepo)
# ==============================================================================
# IMPORTANTE:
# Este proyecto gestiona la configuración de entorno en cada aplicación de forma aislada:
# - Frontend: Frontend_py_whatsaapweb/.env
# - Backend:  WhatsaapWeb-JS/.env
#
# NUNCA incluyas secretos reales, tokens de Meta, contraseñas de BD ni claves API
# en este archivo ni en ningún commit del repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Frontend_py_whatsaapweb/.env)
# ------------------------------------------------------------------------------
# Copia Frontend_py_whatsaapweb/.env.example a Frontend_py_whatsaapweb/.env:
#
# VITE_API_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# 2. BACKEND (WhatsaapWeb-JS/.env)
# ------------------------------------------------------------------------------
# Copia WhatsaapWeb-JS/.env.example a WhatsaapWeb-JS/.env:
#
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=3000
# CORS_ORIGIN=http://localhost:5173
# DEFAULT_COMPANY_ID=1
#
# # Base de datos PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=whatsapp_empresas
# DB_USER=postgres
# DB_PASSWORD=
#
# # Autenticación JWT (mínimo 32 caracteres en producción)
# JWT_SECRET=
# JWT_ACCESS_EXPIRY=24h
# JWT_REFRESH_EXPIRY=30d
#
# # Proveedor WhatsApp y flags de seguridad
# WHATSAPP_PROVIDER=meta-cloud
# WHATSAPP_API_REQUIRE_JWT=true
# WHATSAPP_API_REQUIRE_COMPANY_CLAIM=true
#
# # Meta Cloud API
# META_GRAPH_VERSION=v25.0
# META_WA_PHONE_NUMBER_ID=
# META_WABA_ID=
# META_WA_DISPLAY_PHONE_NUMBER=
# META_WEBHOOK_VERIFY_TOKEN=
# META_WA_ACCESS_TOKEN=
# META_APP_SECRET=
# META_TOKEN_ENCRYPTION_KEY=
#
# # Inteligencia Artificial (OpenCode Zen / OpenAI)
# AI_PROVIDER=opencode
# AI_DEFAULT_MODE=suggest
# OPENCODE_API_URL=https://opencode.ai/zen
# OPENCODE_API_KEY=
# OPENCODE_MODEL=mimo-v2.5-free
# OPENAI_API_KEY=
# OPENAI_MODEL=
