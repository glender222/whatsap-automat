# Variables de entorno para el stack de demostración de Temporal OSS (PR-07)
# Segregado de la base de datos de negocio de WhatsApp

# Puertos expuestos en el Host
TEMPORAL_DB_PORT=5435
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# Persistencia PostgreSQL para Temporal OSS
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal_secret_demo
TEMPORAL_POSTGRES_DB=temporal
TEMPORAL_VISIBILITY_DB=temporal_visibility

# Configuración del Cluster Temporal
TEMPORAL_NAMESPACE=default
TEMPORAL_NAMESPACE_RETENTION=3d
TEMPORAL_TASK_QUEUE=spike-task-queue
TEMPORAL_ADDRESS=localhost:7233
