{
  "name": "silvaprojets",
  "private": true,
  "version": "0.0.0",
  "description": "Whatsap-Automat frontend: React + Vite + Tailwind web workspace",
  "author": "Glender Vargas",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test": "npm run test:tokens && npm run test:campaigns && npm run test:extensions && npm run test:admin && npm run test:marketplace && npm run test:workflows && npm run test:agent-graphs && npm run test:canonical-inbox && npm run test:pdf-media && npm run test:operation-executions && npm run test:auth-session && npm run test:commercial-orders && npm run test:approvals",
    "test:auth-session": "node --import tsx --test src/__tests__/auth-session.test.ts",
    "test:socket-session": "node --import tsx --test src/__tests__/socket-session.integration.mjs",
    "test:tokens": "node --import tsx --test src/styles/tokens.test.ts",
    "test:campaigns": "node --import tsx --test src/__tests__/campaigns.test.ts",
    "test:extensions": "node --import tsx --test src/__tests__/SandboxedExtensionIframe.test.ts",
    "test:admin": "node --import tsx --test src/__tests__/admin-pages.test.ts",
    "test:marketplace": "node --import tsx --test src/__tests__/marketplace.test.ts",
    "test:workflows": "node --import tsx --test src/__tests__/workflows.test.ts",
    "test:agent-graphs": "node --import tsx --test src/__tests__/agent-graphs.test.ts",
    "test:canonical-inbox": "node --import tsx --test src/__tests__/canonical-inbox.test.ts",
    "test:pdf-media": "node --import tsx --test src/__tests__/pdf-media.test.ts",
    "test:operation-executions": "node --import tsx --test src/__tests__/operation-executions.test.ts",
    "test:commercial-orders": "node --import tsx --test src/__tests__/commercial-orders.test.ts",
    "test:approvals": "node --import tsx --test src/__tests__/approvals.test.ts"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "autoprefixer": "^10.4.21",
    "axios": "^1.21.1",
    "docx-preview": "^0.3.7",
    "emoji-mart": "^5.6.0",
    "jotai": "^2.15.0",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^6.5.438",
    "postcss": "^8.5.32",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-player": "^3.3.3",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.17",
    "wavesurfer.js": "^7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.5.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.3.8"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
