# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:5173
DEFAULT_COMPANY_ID=1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_empresas
DB_USER=postgres
DB_PASSWORD=

# JWT (usa un valor aleatorio de al menos 32 caracteres)
JWT_SECRET=
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=30d

# WhatsApp provider
WHATSAPP_PROVIDER=meta-cloud
WHATSAPP_API_REQUIRE_JWT=true
WHATSAPP_API_REQUIRE_COMPANY_CLAIM=true
POLL_INTERVAL_SECONDS=0
POLL_LIMIT=20

# Meta WhatsApp Cloud API
# El verify token debe tener al menos 16 caracteres.
META_GRAPH_VERSION=v25.0
META_WA_PHONE_NUMBER_ID=
META_WABA_ID=
META_WA_DISPLAY_PHONE_NUMBER=
META_WEBHOOK_VERIFY_TOKEN=
META_WA_ACCESS_TOKEN=
META_APP_SECRET=
# Opcional en development: si queda vacia, el token solo se lee desde .env.
# Obligatoria en production y debe tener al menos 32 caracteres.
META_TOKEN_ENCRYPTION_KEY=
META_REQUEST_TIMEOUT_MS=20000

# Cloudflare Quick Tunnel. Dejalo vacio para usar .tools/cloudflared o el PATH.
CLOUDFLARED_BIN=

# IA
AI_PROVIDER=opencode
AI_DEFAULT_MODE=suggest

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT_MS=30000

# OpenCode Zen / endpoint compatible
OPENCODE_API_URL=https://opencode.ai/zen
OPENCODE_API_KEY=
OPENCODE_MODEL=mimo-v2.5-free
OPENCODE_CHAT_PATH=/v1/chat/completions
OPENCODE_MODELS_PATH=/v1/models
OPENCODE_REQUEST_TIMEOUT_MS=30000

# Persistencia y limites
CONVERSATIONS_PERSIST_READS=false
CONVERSATIONS_PERSIST_WRITES=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1500
